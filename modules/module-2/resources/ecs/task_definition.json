[
    {
        "portMappings": [
            {
                "hostPort": 80,
                "protocol": "tcp",
                "containerPort": 80
            }
        ],
        "environment": [
            {
              "name": "RDS_ENDPOINT",
              "value": "RDS_ENDPOINT_VALUE"
            },
            {
              "name": "DB_USERNAME",
              "value": "root"
            }
        ],
        "secrets": [
            {
              "name": "DB_PASSWORD",
              "valueFrom": "RDS_SECRET_ARN_VALUE:password::"
            }
        ],
        "linuxParameters": {
            "initProcessEnabled": true
        },
        "logConfiguration": {
            "logDriver": "awslogs",
            "options": {
                "awslogs-group": "ECS_LOGGROUP_VALUE",
                "awslogs-region": "us-east-1",
                "awslogs-stream-prefix": "ecs",
                "awslogs-create-group": "true"
            }
        },
        "cpu": 0,
        "image": "ECS_IMAGE_VALUE",
        "name": "aws-goat-m2"
    }
]
